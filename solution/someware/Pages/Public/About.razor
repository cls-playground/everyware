@page "/about"

<PageTitle>About</PageTitle>

<div>
    <h1>About @this.projectTitle</h1>
    <p>
        Copyright © 2025 by @this.projectCompany
    </p>
</div>


@* 
********************************************************************************************************************************************
****
**** Defines the logic and interaction handlers for the About page.
****
********************************************************************************************************************************************
*@

@code {

    #region Private Fields

    /// <summary>
    /// A <see cref="String"/> instance representing the configured display name of the copyright company.
    /// </summary>
    private String projectCompany = String.Empty;

    /// <summary>
    /// A <see cref="String"/> instance representing the configured display name of the project.
    /// </summary>
    private String projectTitle = String.Empty;

    #endregion Private Fields

    #region Private Properties

    /// <summary>
    /// Gets or sets the configuration of the application.
    /// </summary>
    [Inject]
    private IConfiguration Configuration { get; set; } = null!;

    #endregion Private Properties

    #region Protected Override Methods

    /// <summary>
    /// Initializes the component by retrieving the project name and the project company from configuration.
    /// </summary>
    protected override void OnInitialized() {

        this.projectCompany = Configuration["Project:Company"]
            ?? throw new InvalidOperationException("Missing configuration for Project:Company");

        this.projectTitle = Configuration["Project:Title"]
            ?? throw new InvalidOperationException("Missing configuration for Project:Name");
    }

    #endregion Protected Override Methods
}

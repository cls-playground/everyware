@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@using Someware.Components.Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4">
            <NavButton Route="about" Icon="bi bi-info-circle-main-layout" Style="Info" Label="About" />
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

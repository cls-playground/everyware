@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization
@using Someware.Components.Navigation
@using Someware.Services
@using Someware.Services.Authentication
@using Someware.Services.Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="@this.projectIcon" alt="App Icon" class="navbar-brand-icon" />
            @this.projectTitle
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <NavButton Route="" Icon="bi bi-house-door-fill-nav-menu" Label="Home" />
        <NavButton Route="counter" Icon="bi bi-plus-square-fill-nav-menu" Label="Counter" />
        <NavButton Route="weather" Icon="bi bi-list-nested-nav-menu" Label="Weather" />
        <NavButton Route="auth" Icon="bi bi-lock-nav-menu" Label="Auth Required" />
        <AuthorizeView>
            <Authorized>
                <NavButton Route="account/manage" Icon="bi bi-person-fill-nav-menu" Label="@context.User.Identity?.Name" />
                <NavButton Icon="bi bi-arrow-bar-left-nav-menu" OnClick="@this.SignOut" Label="Logout" />
            </Authorized>
            <NotAuthorized>
                <NavButton Route="signup" Icon="bi bi-person-nav-menu" Label="Register" />
                <NavButton Route="signin" Icon="bi bi-person-badge-nav-menu" Label="Login" />
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>


@* 
********************************************************************************************************************************************
****
**** Defines the logic and interaction handlers for the main navigation menu.
****
********************************************************************************************************************************************
*@

@code {
    #region Private Fields

    /// <summary>
    /// A <see cref="String"/> instance representing the current base-relative URL used for navigation tracking.
    /// </summary>
    private String? currentUrl;

    /// <summary>
    /// A <see cref="String"/> instance representing the configured filename of the icon associated with the project.
    /// </summary>
    private String projectIcon = String.Empty;

    /// <summary>
    /// A <see cref="String"/> instance representing the configured display name of the project.
    /// </summary>
    private String projectTitle = String.Empty;

    #endregion Private Fields

    #region Private Properties

    /// <summary>
    /// Gets or sets the authentication service used to manage user sessions.
    /// </summary>
    /// <remarks>
    /// This property is injected by the Blazor framework at runtime.
    /// </remarks>
    [Inject]
    private AuthenticationService AuthenticationService { get; set; } = null!;

    /// <summary>
    /// Gets or sets the configuration of the application.
    /// </summary>
    [Inject]
    private IConfiguration Configuration { get; set; } = null!;

    /// <summary>
    /// Gets or sets the navigation manager used to redirect the user.
    /// </summary>
    /// <remarks>
    /// This property is injected by the Blazor framework at runtime.
    /// </remarks>
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    /// <summary>
    /// Gets or sets the redirect manager used to perform safe navigation after logout.
    /// </summary>
    /// <remarks>
    /// This property is injected by the Blazor framework at runtime.
    /// </remarks>
    [Inject]
    private RedirectService RedirectManager { get; set; } = null!;

    #endregion Private Properties

    #region Public Methods

    /// <summary>
    /// Unsubscribes from navigation events to prevent memory leaks.
    /// </summary>
    public void Dispose()

    =>  this.NavigationManager.LocationChanged -= this.OnLocationChanged;

    #endregion Public Methods

    #region Protected Override Methods

    /// <summary>
    /// Initializes the component by capturing the current URL and subscribing to navigation changes.
    /// </summary>
    protected override void OnInitialized() {

        var l_ProjectName = Configuration["Project:Name"]
            ?? throw new InvalidOperationException("Missing configuration for Project:Name");

        this.projectTitle = this.Configuration["Project:Title"]
            ?? throw new InvalidOperationException("Missing configuration for Project:Title");

        var l_ProjectIcon = this.Configuration["Project:Icon"]
            ?? throw new InvalidOperationException("Missing configuration for Project:Icon");

        this.projectIcon = $"projects/{l_ProjectName}/images/{l_ProjectIcon}.png";

        this.currentUrl = this.NavigationManager.ToBaseRelativePath(this.NavigationManager.Uri);
        this.NavigationManager.LocationChanged += this.OnLocationChanged;
    }

    #endregion Protected Override Methods

    #region Private Methods

    /// <summary>
    /// Handles navigation changes by updating the current URL and triggering a UI refresh.
    /// </summary>
    /// <param name="p_Sender">
    /// A nullable <see cref="Object"/> instance representing the event source.
    /// </param>
    /// <param name="p_EventArgs">
    /// A <see cref="LocationChangedEventArgs"/> instance containing the updated location.
    /// </param>
    private void OnLocationChanged(
        Object? p_Sender
    ,   LocationChangedEventArgs p_EventArgs) {

        this.currentUrl = this.NavigationManager.ToBaseRelativePath(p_EventArgs.Location);
        this.StateHasChanged();
    }

    #endregion Private Methods

    #region Private Async Methods

    /// <summary>
    /// Signs out the current user and redirects to the sign-in page.
    /// </summary>
    private async Task SignOut() {

        await this.AuthenticationService.SignOutAsync();
        this.RedirectManager.RedirectTo($"/signin?returnUrl={Uri.EscapeDataString(this.currentUrl ?? "/")}");
    }

    #endregion Private Async Methods
}
